@article{bowenRolePorousStructure2024,
	title = {The role of porous structure on airfoil turbulence interaction noise reduction},
	volume = {36},
	issn = {1070-6631},
	url = {https://doi.org/10.1063/5.0186501},
	doi = {10.1063/5.0186501},
	abstract = {Experiments are performed to investigate the effect of porous treatment structure used at the leading edge on the aerodynamic and aeroacoustic characteristics of a National Advisory Committee for Aeronautics (NACA) 0012 airfoil. Three different triply periodic minimal surface porous structures of constant porosity are studied to explore their effect on the flow field and the relationship between airfoil response and far-field noise. The results show that the ratio between the porous structure pore size and the length scale of the turbulent flow plays an important role in the noise reduction capability of a porous leading edge. Changes to the turbulent flow properties in the vicinity of the airfoil are assessed to characterize the contributing physical behavior responsible for far-field noise manipulation. Velocity field analysis in front of the leading edge demonstrates a pronounced difference among porous structures. Furthermore, close to the airfoil surface and off from the stagnation line, all porous leading edges demonstrate a marked reduction in the low-frequency content of the velocity fluctuations. These results demonstrate the importance of the airfoil leading edge region and not just the stagnation line. The strong link evident in pressure–velocity coherence analysis of the solid airfoil is broken by the introduction of the porous leading edge. Furthermore, the porous leading edges reduce the near-field to far-field pressure coherence in both magnitude and frequency range.},
	number = {2},
	urldate = {2025-09-20},
	journal = {Physics of Fluids},
	author = {Bowen, L. and Celik, A. and Westin, M. F. and Azarpeyvand, M.},
	month = feb,
	year = {2024},
	pages = {025113},
	file = {Full Text PDF:C\:\\Users\\s358959\\Zotero\\storage\\GRYUIGVU\\Bowen et al. - 2024 - The role of porous structure on airfoil turbulence interaction noise reduction.pdf:application/pdf},
}

@inproceedings{zhangInfluencePorousTrailing2022,
	address = {New York, NY, USA},
	series = {{ICITEE} '21},
	title = {Influence of {Porous} {Trailing} {Edge} on {Airfoil} {Aerodynamic} {Performance}},
	isbn = {978-1-4503-8649-4},
	url = {https://doi.org/10.1145/3513142.3513144},
	doi = {10.1145/3513142.3513144},
	abstract = {The porous trailing edge airfoil is an important mean of noise reduction, but porous trailing edge has a certain impact on the aerodynamic performance of airfoil. At this stage, there are few studies on this effect, so A trailing edge porous airfoil based on the NACA65 (12) 10 airfoil is designed and conducted aerodynamic performance research. The diameter of the pores at the trailing edge is d=3 mm, the spacing of the pores is t=6 mm, h=5.8 mm, the porosity is σ=30\%, and the coverage rate is Ψ=20\%. Under the condition of incoming flow velocity of 15 m/s, carry out numerical calculation under different angles of attack from 0° to 15°. Analyze velocity and pressure around the airfoil and study the mechanism. The results show that the trailing edge porous airfoil increases the stall angle of attack. Trailing edge porous airfoil makes air separation from the airfoil surface in advance at small angles of attack, and reduces separation at large angles of attack. These pores increase the upper surface pressure while reducing the lower surface pressure. For mechanism research, these pores increase the vorticity, and the energy is dissipated in the form of vorticity, so the lift coefficient is smaller than the original airfoil. The change of turbulence intensity accords with the change of drag coefficient.},
	urldate = {2025-09-20},
	booktitle = {Proceedings of the 4th {International} {Conference} on {Information} {Technologies} and {Electrical} {Engineering}},
	publisher = {Association for Computing Machinery},
	author = {Zhang, Minghui and Shi, Haijuan},
	month = apr,
	year = {2022},
	pages = {1--5},
}

@article{zhouNumericalSimulationStudy2024,
	title = {Numerical simulation study of the effect of porous media passive flow control on the propulsion performance of airfoils in kármán vortex streets},
	volume = {311},
	issn = {00298018},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0029801824020584},
	doi = {10.1016/j.oceaneng.2024.118720},
	abstract = {This study investigates the influence of porous media on the propulsion performance of airfoils in eddy currents. The passive motion of the airfoil was simulated using overlapping grid technology and the six degrees of freedom method. Research has found that porous media reduces the traction of fixed airfoils and reduces surface turbulence intensity. In the released state, the porous airfoil horizontal movement is slower and the lateral displacement decreases. Combining the two results in a longer forward distance for the NACA0024 thick airfoil, but the effect depends on the release time. This study may inspire the design of underwater robots.},
	language = {en},
	urldate = {2025-09-20},
	journal = {Ocean Engineering},
	author = {Zhou, Zikang and Wang, Ying},
	month = nov,
	year = {2024},
	pages = {118720},
	file = {PDF:C\:\\Users\\s358959\\Zotero\\storage\\BLZ2PLTY\\Zhou and Wang - 2024 - Numerical simulation study of the effect of porous media passive flow control on the propulsion perf.pdf:application/pdf},
}

