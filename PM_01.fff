\begin{figure}
	\centering
	
	\begin{tikzpicture}[
		font=\normalfont\normalsize,
		node distance=4.5mm,
		process/.style={
			rectangle,
			draw,
			rounded corners=3pt,
			thick,
			align=center,
			text width=0.72\linewidth,
			minimum height=8mm,
			inner sep=3pt
		},
		output/.style={
			rectangle,
			draw,
			double,
			rounded corners=3pt,
			thick,
			align=center,
			text width=0.62\linewidth,
			minimum height=10mm,
			inner sep=3pt
		},
		arrow/.style={
			-{Latex[length=1.8mm]},
			thick
		}
		]
		
		\node[process] (height)
		{Select pore height\\
			$H=8,\;9,\;10~\mathrm{mm}$};
		
		\node[process, below=of height] (init)
		{Initialise with zero transpiration\\
			$v_{n,i}^{(0)}=0$};
		
		\node[process, below=of init] (panel)
		{Solve source--vortex panel system};
		
		\node[process, below=of panel] (pressure)
		{Compute pressure difference across each pore\\
			$\Delta p_k=p_{1,k}-p_{2,k}$};
		
		\node[process, below=of pressure] (flow)
		{Solve internal pore-flow model\\
			to obtain $Q_k$ and $Re_{D,k}$};
		
		\node[process, below=of flow] (update)
		{Update surface-normal velocities\\
			at the pore openings};
		
		\node[process, below=of update] (iterate)
		{Iterate aero--hydraulic coupling\\
			until convergence};
		
		\node[output, below=of iterate] (results)
		{Report $C_p$, $C_L$, $C_{D,p}$, $C_M$,\\
			$Q$, $\Delta p$ and $Re_D$};
		
		\draw[arrow] (height) -- (init);
		\draw[arrow] (init) -- (panel);
		\draw[arrow] (panel) -- (pressure);
		\draw[arrow] (pressure) -- (flow);
		\draw[arrow] (flow) -- (update);
		\draw[arrow] (update) -- (iterate);
		\draw[arrow] (iterate) -- (results);
		
	\end{tikzpicture}
	
	\caption{{\normalfont\normalsize
			Coupled aero--hydraulic solution procedure applied to
			the investigated pore heights.}}
	\label{fig:coupled_iteration_loop}
\end{figure}
